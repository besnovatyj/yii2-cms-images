{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "baseUrl": ".",
        "rootDir": "./src",
        "outDir": "./dist",
        "sourceMap": true,
        "removeComments": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": [
        "./src/**/*"
    ],
    "exclude": ["node_modules", "./src/vendor/**/*"]
}
